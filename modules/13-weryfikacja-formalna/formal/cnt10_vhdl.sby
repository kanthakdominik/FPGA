# cnt10 w VHDL + PSL przez wtyczkę GHDL (13.02). Uruchomienie: sby -f cnt10_vhdl.sby [zadanie]
#   prove — indukcja: PASS (assert_range jest niezmiennikiem, więc dowód domyka się od razu)
#   cover — dwa przejścia 9 -> 0: PASS (ślad co najmniej 21 taktów)

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 2
cover: mode cover
cover: depth 25

[engines]
smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl cnt10.vhd cnt10_formal.vhd -e cnt10_formal
prep -top cnt10_formal

[files]
../hdl/vhdl/cnt10.vhd
cnt10_formal.vhd
